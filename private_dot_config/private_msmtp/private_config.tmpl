defaults
auth		on
tls		on
tls_starttls	on

account		disroot
host		disroot.org
port		587
auth		on
from		{{ .emailDis }}
user		{{ .userDis }}
passwordeval	passage {{ .emailDis }}

account		bimsa
host		smtp.exmail.qq.com
port		465
auth		on
from		{{ .userBimsa }}
user		{{ .userBimsa }}
passwordeval	passage bimsa-email
tls_starttls	off

account		gmail
host		smtp.gmail.com
port		587
auth		oauthbearer
from		{{ .emailGmail }}
user		{{ .emailGmail }}
passwordeval	pizauth show google

account		uni1
host		smtp.gmail.com
port		587
auth		oauthbearer
from		{{ .emailUni1 }}
user		{{ .emailUni1 }}
passwordeval	pizauth show uni1

account		runbox
host		mail.runbox.com
port		587
auth		on
from		{{ .alias1Runbox }}
user		{{ .userRunbox }}
passwordeval	passage runbox-msmtp

account default : runbox
